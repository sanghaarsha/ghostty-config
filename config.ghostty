# Ghostty Configuration

# Color Scheme / Theme
# theme = Gruvbox Material Dark
# theme = Everforest Dark Hard
theme = Catppuccin Mocha

# Typography
font-family = CaskaydiaMono Nerd Font Mono
font-size = 13

# Shell
command = /usr/bin/zsh

# Window Dimensions & Geometry
window-width = 100
window-height = 27

# Window Decorations
window-decoration = false
gtk-titlebar = false

# Padding & Alignment
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true

# Transparency & Blur
background-opacity = 0.98
background-blur = true

# Bell Behavior
bell-features = no-audio

# Keybindings
keybind = ctrl+shift+enter=new_window

# Quick reload config
keybind = ctrl+shift+,=reload_config
